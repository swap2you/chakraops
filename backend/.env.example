# Environment variables for ChakraOps
# Copy this file to .env and fill in your values. Never commit real secrets.

# ORATS Live Data (options) - https://orats.com
ORATS_API_TOKEN=your-orats-token-here

# Schedulers - fail-closed defaults (R40.1)
# Shell / start_chakraops.ps1 wins over .env for protected keys when set.
# Without CHAKRAOPS_ALLOW_ENV_SCHEDULER_OPT_IN=true, code forces master+legacy false
# even if .env sets them true.
CHAKRAOPS_SCHEDULER_ENABLED=false
CHAKRAOPS_LEGACY_SCHEDULERS_ENABLED=false
CHAKRAOPS_ALLOW_ENV_SCHEDULER_OPT_IN=false
NIGHTLY_EVAL_ENABLED=false
EOD_CHAIN_ENABLED=false
EOD_FREEZE_ENABLED=false

# Optional Slack webhooks (any one enables Slack sends)
# SLACK_WEBHOOK_CRITICAL=
# SLACK_WEBHOOK_SIGNALS=
# SLACK_WEBHOOK_HEALTH=
# SLACK_WEBHOOK_DAILY=

# Optional UI / API keys
# UI_API_KEY=
# CHAKRAOPS_API_KEY=

# AUTH-001 — session auth (paths only; never put passwords/hashes/secrets in Git)
# Local default: disabled (existing tests / Cowork flows stay open).
# Production-like local: required + bootstrap hashes under C:\ChakraOpsSecrete
# CHAKRAOPS_PRODUCTION=true forces required and fail-closed if secrets missing.
CHAKRAOPS_AUTH_MODE=disabled
# CHAKRAOPS_PRODUCTION=false
# CHAKRAOPS_SECRET_ROOT=C:\ChakraOpsSecrete
# CHAKRAOPS_AUTH_USERS_PATH=C:\ChakraOpsSecrete\chakraops_auth_users.json
# CHAKRAOPS_SESSION_SECRET_PATH=C:\ChakraOpsSecrete\chakraops_session_secret
# CHAKRAOPS_SESSION_IDLE_SECONDS=1800
# CHAKRAOPS_SESSION_ABSOLUTE_SECONDS=43200
# CHAKRAOPS_AUTH_COOKIE_SECURE=false
# CHAKRAOPS_AUTH_COOKIE_SAMESITE=lax
# CHAKRAOPS_LOGIN_RATE_LIMIT=5
# CHAKRAOPS_LOGIN_RATE_WINDOW_SECONDS=900

# Optional TTS / Copilot
# OPENAI_API_KEY=

# R51 data platform — prefer Postgres in production; unset → local SQLite under data/
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/chakraops

# R52/R70 Robinhood MCP read-only (never commit real tokens)
# Prefer ChakraOps OAuth store (scripts/robinhood_mcp_authorize.ps1). Cursor MCP ≠ app auth.
# ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_OAUTH_STORE=C:\ChakraOpsSecrete\robinhood
# Migration fallbacks only (prefer OAuth store above):
# ROBINHOOD_MCP_ACCESS_TOKEN=
# ROBINHOOD_MCP_TOKEN_PATH=

