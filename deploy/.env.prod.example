# R57 — Production environment template (copy to deploy/.env.prod; never commit secrets).
# Usage:
#   copy deploy\.env.prod.example deploy\.env.prod
#   docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.prod up -d --build
#
# Safety (fail-closed): scheduler OFF, no broker writes, manual tickets only.
# Never flip trade_execution or enable write/order paths in any environment.

# --- Public URL / CORS (domain-ready; leave localhost for local prod-mode validation) ---
APP_PUBLIC_URL=http://127.0.0.1:18873
CORS_ORIGINS=http://127.0.0.1:18873,http://localhost:18873

# --- Database (Postgres preferred in production; compose profile "postgres" supplies host "postgres") ---
# Replace password before use. Image builds must NOT bake this value.
DATABASE_URL=postgresql+psycopg://chakraops:CHANGE_ME@postgres:5432/chakraops
POSTGRES_USER=chakraops
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=chakraops

# --- API / UI auth ---
UI_API_KEY=CHANGE_ME_STRONG_UI_KEY
# CHAKRAOPS_API_KEY=

# --- Robinhood MCP read-only (prefer token file mount; never bake tokens into images) ---
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
# Prefer path over inline token in production:
ROBINHOOD_MCP_TOKEN_PATH=/run/secrets/robinhood_mcp_token
# ROBINHOOD_MCP_ACCESS_TOKEN=

# --- ORATS (options / strategy data) ---
ORATS_API_TOKEN=CHANGE_ME_ORATS_TOKEN
# ORATS_API_KEY=

# --- Scheduler / execution safety (must stay false for R57 scaffolding) ---
CHAKRAOPS_SCHEDULER_ENABLED=false
CHAKRAOPS_LEGACY_SCHEDULERS_ENABLED=false
CHAKRAOPS_ALLOW_ENV_SCHEDULER_OPT_IN=false
NIGHTLY_EVAL_ENABLED=false
EOD_CHAIN_ENABLED=false
EOD_FREEZE_ENABLED=false

# Explicit non-execution posture (app also hard-codes manual_only / trade_execution=false)
trade_execution=false
manual_only=true

# --- Optional: advisory monitor worker profile (placeholder; does not enable scheduler) ---
# CHAKRAOPS_MONITOR_ENABLED=false
