# ChakraOps frontend — optional; defaults work for MOCK.
# For LIVE, point to the backend serving /api/view/* and optionally /api/healthz.

# Base URL of the ChakraOps API (no trailing slash).
# Example: http://127.0.0.1:18800 (ChakraOps dedicated backend port; see scripts/chakraops_ports.ps1)
VITE_API_BASE_URL=http://127.0.0.1:18800
CHAKRAOPS_BACKEND_PORT=18800
CHAKRAOPS_FRONTEND_PORT=18873
