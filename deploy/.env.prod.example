# R63 — Production environment for https://chakraops.cloud
# Copy to deploy/.env.prod or /opt/chakraops/secrets/env.prod — NEVER commit secrets.
#
# Do not use dauji.info for ChakraOps.

APP_PUBLIC_URL=https://chakraops.cloud
# Server reads UI_CORS_ORIGINS (not CORS_ORIGINS) — R70-DEF-090
UI_CORS_ORIGINS=https://chakraops.cloud

CHAKRAOPS_PRODUCTION=true
APP_ENV=production
DEPLOY_ENV=production

# PostgreSQL mandatory in production
DATABASE_URL=postgresql+psycopg://chakraops:CHANGE_ME@postgres:5432/chakraops
POSTGRES_USER=chakraops
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=chakraops

UI_API_KEY=CHANGE_ME_STRONG_UI_KEY

ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_TOKEN_PATH=/run/secrets/robinhood_mcp_token
# Host path for compose mount (VPS):
# ROBINHOOD_TOKEN_HOST_PATH=/opt/chakraops/secrets/robinhood_mcp_token
# CLOUDFLARE_TUNNEL_TOKEN_HOST_PATH=/opt/chakraops/secrets/cloudflare_tunnel_token

ORATS_API_TOKEN=CHANGE_ME_ORATS_TOKEN

CHAKRAOPS_SCHEDULER_ENABLED=false
CHAKRAOPS_LEGACY_SCHEDULERS_ENABLED=false
CHAKRAOPS_ALLOW_ENV_SCHEDULER_OPT_IN=false
NIGHTLY_EVAL_ENABLED=false
EOD_CHAIN_ENABLED=false
EOD_FREEZE_ENABLED=false
trade_execution=false
manual_only=true

R54_MONITOR_INTERVAL_SEC=90

# Optional Slack (webhook secret file preferred on VPS)
# SLACK_WEBHOOK_SIGNALS=
# SLACK_WEBHOOK_CRITICAL=
