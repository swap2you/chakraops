# Default: normalize text files to LF.
* text=auto eol=lf

# Source and documentation.
*.py      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.mdc     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.sh      text eol=lf
*.ps1     text eol=lf
*.css     text eol=lf
*.html    text eol=lf

# Binary files.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.docx    binary
*.zip     binary
*.tar     binary
*.gz      binary
*.parquet binary
*.sqlite  binary
*.db      binary
