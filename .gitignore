# env / secrets
.env
*.env
# Ignore all dotenv variants (e.g. .env.development, .env.local) so local dev
# env files (like frontend/.env.development) are never committed.
.env.*
# Keep committed example/template files tracked.
!.env.example
!frontend/.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Node / frontend
node_modules/
frontend/dist/
*.tsbuildinfo
*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Data / logs (keep structure, ignore large or sensitive)
*.db
logs/
out/
# R26.6: data/ contains journal DBs, checklists, reports (back up with scripts/backup_data.sh)
data/
*out/*
